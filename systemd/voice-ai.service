[Unit]
Description=Voice AI Assistant Daemon (Rust Native)
Documentation=https://github.com/TuNgocCoder-zako/voiceAI_Rust
After=graphical-session.target pipewire.service pipewire-pulse.service
PartOf=graphical-session.target
Wants=pipewire.service

[Service]
Type=simple
WorkingDirectory=%h/Projects/rust/voice-ai
ExecStart=%h/.local/bin/ai-assistant-rs
Restart=always
RestartSec=3
Environment=PATH=%h/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=GGML_VK_VISIBLE_DEVICES=1
Environment=AI_ASSISTANT_WHISPER_GPU=0
Environment=AI_ASSISTANT_WHISPER_MODEL=%h/Projects/rust/voice-ai/models/whisper/ggml-large-v3-turbo-q5_0.bin
Environment=PICOVOICE_ACCESS_KEY=
Environment=AI_ASSISTANT_PORCUPINE_SENSITIVITY=0.65
Environment=AI_ASSISTANT_WAKE_THRESHOLD=0.35
PassEnvironment=WAYLAND_DISPLAY DISPLAY XDG_CURRENT_DESKTOP XDG_RUNTIME_DIR DBUS_SESSION_BUS_ADDRESS XAUTHORITY
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=graphical-session.target
