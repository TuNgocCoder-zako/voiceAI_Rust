[Unit]
Description=Voice AI Assistant Daemon (Rust Native)
Documentation=https://github.com/TuNgocCoder-zako/voiceAI_Rust
After=graphical-session.target pipewire.service pipewire-pulse.service
Wants=pipewire.service

[Service]
Type=simple
WorkingDirectory=%h/Projects/rust/voice-ai
ExecStart=%h/.local/bin/ai-assistant-rs
Restart=always
RestartSec=3
Environment=PATH=%h/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
PassEnvironment=WAYLAND_DISPLAY DISPLAY XDG_CURRENT_DESKTOP XDG_RUNTIME_DIR
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=graphical-session.target
